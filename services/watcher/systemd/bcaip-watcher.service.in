[Unit]
Description=BCAIP Update Watcher
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=@WATCHER_EXECUTABLE@
Environment="BCAIP_WATCHER_CONFIG_DIR=@WATCHER_CONFIG_DIR@"
Environment="BCAIP_WATCHER_STATE_DIR=@WATCHER_STATE_DIR@"
Environment="BCAIP_WATCHER_BIND_ADDRESS=@WATCHER_BIND_ADDRESS@"

Restart=always
RestartSec=2

KillMode=control-group
TimeoutStopSec=30

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
