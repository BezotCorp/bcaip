[Unit]
Description=BCAIP Watcher
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=20

[Service]
Type=simple
Slice=bcaip.slice

ExecStart=@WATCHER_EXECUTABLE@

Environment="BCAIP_DATA_DIR=@DATA_DIR@"
Environment="BCAIP_LAUNCHER_NAME=local_launcher"
Environment="BCAIP_WATCHER_NAME=watcher"

Restart=always
RestartSec=30

KillMode=control-group
TimeoutStopSec=30

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
